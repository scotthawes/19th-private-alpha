# Copy to .env and fill in. .env is gitignored — keys are shown once at
# https://app.19th.com/api-keys, so save them when they appear.

# Training API key — needs training:write, training:read and (for inline
# predict records) inference:invoke.
TRAINING_API_KEY=

# Inference API key — only needed to call an existing hosted endpoint that the
# training key cannot reach. Training keys with inference:invoke can call the
# model-version prediction URL returned by fit.
INFERENCE_API_KEY=

# Override only if 19th moves the endpoints.
# TRAINING_ORIGIN=https://training.19th.com
# INFERENCE_ORIGIN=https://inference.get19th.com
